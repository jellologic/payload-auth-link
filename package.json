{
  "name": "payload-auth-link-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run clean && tsc -b packages/core packages/plugin packages/react packages/web packages/next packages/tanstack-start packages/provider-better-auth packages/provider-authjs",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run coverage && bun run size && bun run api:check && bun run schema:check && bun run consumer:check",
    "dev:example": "bun run build && cd examples/basic && bun run dev",
    "size": "size-limit",
    "e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
    "e2e:postgres": "bun run build && playwright test -c e2e/playwright.postgres.config.ts",
    "e2e:mongo": "bun run build && bun e2e/run-mongo.mjs",
    "e2e:tanstack": "bun run build && playwright test -c e2e/playwright.tanstack.config.ts",
    "e2e:tanstack-postgres": "bun run build && playwright test -c e2e/playwright.tanstack-postgres.config.ts",
    "e2e:tanstack-mongo": "bun run build && bun e2e/run-tanstack-mongo.mjs",
    "e2e:seed-gate": "bun run build && playwright test -c e2e/playwright.seed-gate.config.ts",
    "release:check": "bun run build && bun scripts/release-check.mjs && bun run release:smoke",
    "docs:api": "typedoc",
    "docs:media": "bun run build && bun scripts/capture-media.mjs",
    "docs:llms": "bun scripts/build-llms.mjs",
    "docs:check": "bun run build && bun scripts/check-docs.mjs && typedoc --treatWarningsAsErrors",
    "release": "bun scripts/publish.mjs",
    "verify:published": "bun scripts/verify-published.mjs",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release:smoke": "bun scripts/install-smoke.mjs",
    "api:snapshot": "bun scripts/api-snapshot.mjs --write",
    "api:check": "bun scripts/api-snapshot.mjs --check",
    "schema:snapshot": "bun scripts/schema-snapshot.mjs --write",
    "schema:check": "bun scripts/schema-snapshot.mjs --check",
    "consumer:check": "tsc -p scripts/consumer-fixture/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
