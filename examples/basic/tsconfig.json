{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    // An app, not a library: no declaration output (whose inference
    // limits would otherwise fail the check on the engine exports).
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "incremental": true,
    "allowJs": true,
    // A Next.js app lives in the bundler world (and Next.js ships no
    // `exports` map, so `next/*` only resolves here).
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./payload.config.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
