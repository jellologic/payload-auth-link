{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    // Next.js ships no `exports` map, so `next/*` subpaths only resolve
    // under bundler resolution — the same world this adapter ships to.
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../react"
    },
    {
      "path": "../web"
    }
  ]
}
