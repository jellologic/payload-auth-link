{
  "name": "@payload-auth-link/web",
  "version": "0.2.2",
  "description": "payload-auth-link framework-free web-adapter toolkit: route handlers, session verification, server authorization, redirect safety.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-auth-link.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/jellologic/payload-auth-link/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/jellologic/payload-auth-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@types/node": "^26"
  }
}
