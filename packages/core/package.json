{
  "name": "@payload-auth-link/core",
  "version": "0.1.1",
  "description": "payload-auth-link core: framework-free auth domain and port interfaces.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
