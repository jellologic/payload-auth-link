{
  "name": "@payload-auth-link/migrate",
  "version": "0.14.3",
  "description": "payload-auth-link migration kit: read-only doctor/preflight, the payload-auth importer, and exporters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-auth-link.git",
    "directory": "packages/migrate"
  },
  "homepage": "https://github.com/jellologic/payload-auth-link/tree/main/packages/migrate#readme",
  "bugs": {
    "url": "https://github.com/jellologic/payload-auth-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "payload-auth-link-migrate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@better-auth/api-key": "1.7.12",
    "@payload-auth-link/core": "workspace:*",
    "@payload-auth-link/plugin": "workspace:*",
    "@payload-auth-link/provider-better-auth": "workspace:*",
    "@payloadcms/db-postgres": "3.91.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "better-auth": "1.7.12",
    "payload": "3.91.0"
  },
  "peerDependencies": {
    "@payload-auth-link/next": "^0.8.7",
    "payload": "^3.83.0 || 4.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@payload-auth-link/next": {
      "optional": true
    },
    "payload": {
      "optional": false
    }
  }
}
