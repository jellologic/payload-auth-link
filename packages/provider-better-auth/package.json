{
  "name": "@payload-auth-link/provider-better-auth",
  "version": "0.5.0",
  "description": "payload-auth-link Better Auth provider adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-auth-link.git",
    "directory": "packages/provider-better-auth"
  },
  "homepage": "https://github.com/jellologic/payload-auth-link/tree/main/packages/provider-better-auth#readme",
  "bugs": {
    "url": "https://github.com/jellologic/payload-auth-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "default": "./dist/cookies.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.6 <1.8.0",
    "payload": "^3.83.0 || 4.0.0-beta.0"
  },
  "devDependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@payload-auth-link/plugin": "workspace:*",
    "@payloadcms/db-sqlite": "3.90.2",
    "better-auth": "1.7.7",
    "payload": "3.90.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
