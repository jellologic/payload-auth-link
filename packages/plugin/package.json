{
  "name": "@payload-auth-link/plugin",
  "version": "0.11.0",
  "description": "payload-auth-link for Payload CMS: collections, auth strategy, endpoints, hooks, admin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-auth-link.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/jellologic/payload-auth-link/tree/main/packages/plugin#readme",
  "bugs": {
    "url": "https://github.com/jellologic/payload-auth-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "payload": "^3.83.0 || 4.0.0-beta.0",
    "react": "^19.0.0",
    "@payloadcms/ui": "^3.83.0 || 4.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/graphql": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "payload": "3.90.2",
    "react": "19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
