{
  "name": "@payload-auth-link/provider-authjs",
  "version": "0.1.1",
  "description": "payload-auth-link Auth.js provider adapter.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "default": "./dist/cookies.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*",
    "@auth/core": "^0.41.0",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "payload": "^3.0.0 || ^4.0.0-beta.0"
  },
  "devDependencies": {
    "@payload-auth-link/plugin": "workspace:*",
    "@payloadcms/db-sqlite": "3.90.2",
    "payload": "3.90.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
