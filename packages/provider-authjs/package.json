{
  "name": "@payload-auth-link/provider-authjs",
  "version": "0.8.0",
  "description": "payload-auth-link Auth.js provider adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellologic/payload-auth-link.git",
    "directory": "packages/provider-authjs"
  },
  "homepage": "https://github.com/jellologic/payload-auth-link/tree/main/packages/provider-authjs#readme",
  "bugs": {
    "url": "https://github.com/jellologic/payload-auth-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "default": "./dist/cookies.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src",
    "!src/**/__tests__",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@payload-auth-link/core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "@auth/core": ">=0.41.0 <0.42.0",
    "payload": "^3.83.0 || 4.0.0-beta.0"
  },
  "devDependencies": {
    "@payload-auth-link/plugin": "workspace:*",
    "@payload-auth-link/web": "workspace:*",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.91.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
